# Copy to .env and fill in. Never commit .env — secrets live here only (see CLAUDE.md).

# Supabase Postgres connection string (Session pooler recommended for serverless/dev).
# Format: postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres
DATABASE_URL=""
# Direct (non-pooled) connection, used by Prisma Migrate. Supabase: same host, port 5432, no pgbouncer.
DIRECT_URL=""

# Supabase project — used for Storage (lesson plans, progress reports, narrative reports, portfolios).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Auth.js
AUTH_SECRET=""

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:cte@antiquespride.edu.ph"
